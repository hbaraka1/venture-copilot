{
  "name": "venture-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node --env-file-if-exists=.env apps/api/src/server.mjs",
    "start": "node apps/api/src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check apps/api/src/server.mjs && node --check packages/agents/src/orchestrator.mjs && node --check apps/web/public/app.js"
  },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
